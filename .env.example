# ===== ฐานข้อมูล (Neon) =====
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ===== ระบบล็อกอิน =====
SESSION_SECRET="สุ่มยาวๆ"   # คีย์เซ็น session (สำคัญ! ต้องตั้ง)
STARTING_POINTS="100"        # คะแนนเริ่มต้นสมาชิกใหม่ (กระดานคะแนน)
# ไม่ต้องใช้ ADMIN_PASSWORD แล้ว — เปลี่ยนเป็นระบบบัญชีรายคน

# ===== แจ้งเตือนเข้ากลุ่ม LINE =====
# จาก LINE Official Account -> Messaging API
LINE_CHANNEL_ACCESS_TOKEN=""   # Channel access token (สำหรับส่งข้อความ)
LINE_CHANNEL_SECRET=""         # Channel secret (ตรวจลายเซ็น webhook - แนะนำใส่)
# groupId จับอัตโนมัติจาก webhook เมื่อเชิญบอทเข้ากลุ่ม (ไม่ต้องกรอกเอง)
# ถ้าจะกำหนดเองก็ได้:
# LINE_GROUP_ID=""
LINE_NOTIFY_TASKS="true"       # "false" = เตือนเฉพาะประกาศ (ประหยัดโควต้า)
